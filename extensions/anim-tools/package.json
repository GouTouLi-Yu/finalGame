{
  "name": "anim-tools",
  "version": "1.0.0",
  "package_version": 2,
  "description": "动画工具 - 序列帧命名与帧动画一键制作",
  "main": "./main.js",
  "author": "",
  "editor": ">=3.8.0",
  "panels": {
    "build": {
      "title": "一键制作帧动画",
      "main": "./panel-build.js",
      "type": "dockable",
      "size": {
        "width": 560,
        "height": 480
      }
    }
  },
  "contributions": {
    "messages": {
      "anim-tools:open-build-panel": {
        "methods": [
          "openBuildPanel"
        ]
      },
      "anim-tools:get-config": {
        "methods": [
          "getConfig"
        ]
      },
      "anim-tools:set-config": {
        "methods": [
          "setConfig"
        ]
      },
      "anim-tools:pick-folder": {
        "methods": [
          "pickFolder"
        ]
      },
      "anim-tools:suggest-prefix": {
        "methods": [
          "suggestPrefix"
        ]
      },
      "anim-tools:build-frame-anim": {
        "methods": [
          "buildFrameAnimAction"
        ]
      }
    }
  }
}
