{
  "name": "tinypng-tools",
  "version": "1.0.0",
  "package_version": 2,
  "description": "TinyPNG 图片压缩 - 选择文件夹原地压缩",
  "main": "./main.js",
  "author": "",
  "editor": ">=3.8.0",
  "panels": {
    "default": {
      "title": "TinyPNG 压缩",
      "main": "./panel.js",
      "type": "dockable",
      "size": {
        "width": 560,
        "height": 480
      }
    }
  },
  "contributions": {
    "messages": {
      "tinypng-tools:open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "tinypng-tools:get-config": {
        "methods": [
          "getConfig"
        ]
      },
      "tinypng-tools:set-config": {
        "methods": [
          "setConfig"
        ]
      },
      "tinypng-tools:pick-folder": {
        "methods": [
          "pickFolder"
        ]
      },
      "tinypng-tools:compress-folder": {
        "methods": [
          "compressFolder"
        ]
      }
    }
  },
  "dependencies": {
    "tinify": "^1.7.0"
  }
}
