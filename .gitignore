# Cocos Creator 项目

# 编辑器生成的缓存目录（不提交）
library/
temp/
local/
build/
native/

# 编辑器个人配置（每台机器不同，不提交）
profiles/

# 本地资源目录（目录联接，各开发者自行配置，不提交）
assets/res/

# 配置表导出目录（由 Excel 插件本地生成，不提交）
assets/config/

# Excel 导表插件本地缓存（路径与 hash 因机器而异，不提交）
extensions/export-excel/cache/fileCache.json

# 依赖目录
node_modules/

# basisu / BC 纹理测试产物（勿提交）
sample_*
tools/basisu/

# 系统文件
.DS_Store
Thumbs.db
